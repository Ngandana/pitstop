# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never exposed to the browser. Not used by Milestone 1, but
# required once admin-level Supabase Auth actions are needed.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string. Project Settings -> Database in Supabase.
# Use the *direct* connection (port 5432) for local dev and for running
# migrations. If you deploy to Vercel, switch to the "Transaction pooler"
# connection string (port 6543) there instead — src/db/index.ts already
# passes `prepare: false`, which is required for pooled connections.
DATABASE_URL=

# --- Auth --------------------------------------------------------------
# The only email allowed to request a magic link (§4: single owner account).
OWNER_EMAIL=
# Used to build the magic-link redirect URL. http://localhost:3000 for
# local dev; your production URL once deployed to Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cartrack (Milestone 3) --------------------------------------------
CARTRACK_USERNAME=
CARTRACK_PASSWORD=
CARTRACK_BASE_URL=

# --- Resend (Milestone 6) -----------------------------------------------
RESEND_API_KEY=
