# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real credentials.

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, never exposed to the browser. Not used by Milestone 1, but
# required once admin-level Supabase Auth actions are needed.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string. Project Settings -> Database in Supabase.
# Supabase's *direct* connection (port 5432) resolves IPv6-only — use the
# **Session pooler** connection string instead for local dev/migrations
# (works over IPv4). On Vercel, use the **Transaction pooler** (port 6543)
# — src/db/index.ts already passes `prepare: false`, which pooled
# connections require. See README's "Note on Supabase's direct connection".
DATABASE_URL=

# --- Auth --------------------------------------------------------------
# The only email allowed to request a magic link (§4: single owner account).
OWNER_EMAIL=
# Used to build the magic-link redirect URL. http://localhost:3000 for
# local dev; your production URL once deployed to Vercel.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cartrack (Milestone 3) --------------------------------------------
CARTRACK_USERNAME=
CARTRACK_PASSWORD=
# Region-specific — South Africa is fleetapi-za.cartrack.com. Full list at
# https://developer.cartrack.com/openapi/openapi.yaml (`servers:`).
CARTRACK_BASE_URL=https://fleetapi-za.cartrack.com/rest

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET`
# on scheduled requests (see vercel.json + src/app/api/cron/*). Generate
# with e.g. `openssl rand -hex 32`.
CRON_SECRET=

# --- Resend (Milestone 6) -----------------------------------------------
RESEND_API_KEY=
